[Unit]
Description=Options monitoring capture (quiet, no DingTalk delivery)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=optionmonitor
Group=optionmonitor
WorkingDirectory=/opt/option-monitor
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/optionmonitor
EnvironmentFile=/opt/option-monitor/.env
ExecStart=/opt/option-monitor/deploy/option-monitor-capture.sh
