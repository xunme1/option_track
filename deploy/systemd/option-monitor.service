[Unit]
Description=Options monitoring report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=optionmonitor
Group=optionmonitor
WorkingDirectory=/opt/option-monitor
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/optionmonitor
EnvironmentFile=/opt/option-monitor/.env
ExecStart=/opt/option-monitor/.venv/bin/python /opt/option-monitor/scripts/run_and_deliver_options_monitor.py --root /opt/option-monitor --force-anomaly-report --force-all-products --require-full-coverage
